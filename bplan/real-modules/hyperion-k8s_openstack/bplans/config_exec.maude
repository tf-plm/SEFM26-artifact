                a(CREATE, 'openstack_networking_network_v2.hyperion-network) -> neighbors(eps)
                a(UPDATE, 'openstack_compute_instance_v2.hyperion-master) -> neighbors(a(CREATE, 'openstack_networking_network_v2.hyperion-network))
