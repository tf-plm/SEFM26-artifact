                'openstack_compute_instance_v2.hyperion-nodes -> 'openstack_compute_floatingip_v2.fip-nodes
                'openstack_compute_instance_v2.hyperion-nodes -> 'openstack_networking_network_v2.hyperion-network
                'openstack_networking_subnet_v2.hyperion-network -> 'openstack_networking_network_v2.hyperion-network
            )
        ),
        state(
            resources: (
                ri('openstack_compute_floatingip_v2.fip-master,old)
                ri('openstack_compute_floatingip_v2.fip-nodes,old)
                ri('openstack_compute_instance_v2.hyperion-master,old)
                ri('openstack_compute_instance_v2.hyperion-nodes,old)
                ri('openstack_compute_keypair_v2.hyperion-key,old)
                ri('openstack_compute_secgroup_v2.hyperion-sg,old)
                ri('openstack_networking_network_v2.hyperion-network,old)
                ri('openstack_networking_subnet_v2.hyperion-network,old)
            ),
            dependencies: (
                ri('openstack_compute_instance_v2.hyperion-master,old) -> ri('openstack_compute_secgroup_v2.hyperion-sg,old)
                ri('openstack_compute_instance_v2.hyperion-master,old) -> ri('openstack_compute_floatingip_v2.fip-master,old)
                ri('openstack_compute_instance_v2.hyperion-master,old) -> ri('openstack_networking_network_v2.hyperion-network,old)
